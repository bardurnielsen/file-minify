# Copy to .env next to docker-compose.yml and adjust for this host. Every value
# is optional; the defaults are shown. `docker compose up -d` applies changes
# (no rebuild needed).

# Largest file a user may upload, in MB. Phones record roughly 150 MB per
# minute of 1080p and 300-400 MB per minute of 4K.
#MAX_FILE_MB=50

# Timeout for each external command (ffmpeg, Ghostscript, LibreOffice), in
# minutes. A long video on a slow CPU needs more; backend/test/bench.sh shows
# how long encodes take on this host.
#PROCESS_TIMEOUT_MIN=5

# CPU weight for the backend relative to other containers (Docker default is
# 1024). Only matters when the CPU is busy: lower yields more to other apps.
# The resulting kernel weight depends on the runtime; bench.sh prints it. On
# newer runc: 512 -> 59, 256 -> 34, 128 -> 20, against 100 for a default
# container.
#BACKEND_CPU_SHARES=512

# Where uploads and results are kept. Default is the named volume temp_files
# under /var/lib/docker. A host path must be a dedicated directory writable by
# uid 1000 - everything in it older than an hour is deleted.
#TEMP_DIR=/srv/appdata/file-minify/temp
